",\n","    \"calculate_debt_ratio\": \"COMPUTE\",\n","    \"propose_limit_change\": \"PROPOSE\",\n","    \"apply_limit_change\": \"WRITE\",\n","}\n","\n","def execute_tool_call(\n","    response_id,\n","    call_id,\n","    name,\n","    arguments_json,\n","    allowed_tool_names,\n","):\n","    start = time.perf_counter()\n","\n","    try:\n","        arguments = json.loads(arguments_json)\n","    except Exception as exc:\n","        result = {\n","            \"status\": \"DENIED\",\n","            \"reason\": \"INVALID_JSON_ARGUMENTS\",\n","            \"detail\": str(exc),\n","        }\n","        arguments = {}\n","\n","    if name not in allowed_tool_names:\n","        result = {\n","            \"status\": \"DENIED\",\n","            \"reason\": \"TOOL_NOT_ALLOWED_IN_SCOPE\",\n","            \"tool\": name,\n","        }\n","\n","    elif name not in TOOL_FUNCTIONS:\n","        result = {\n","            \"status\": \"DENIED\",\n","            \"reason\": \"UNKNOWN_TOOL\",\n","            \"tool\": name,\n","        }\n","\n","    else:\n","        try:\n","            result = TOOL_FUNCTIONS[name](**arguments)\n","        except Exception as exc:\n","            result = {\n","                \"status\": \"ERROR\",\n","                \"reason\": type(exc).__name__,\n","                \"detail\": str(exc),\n","            }\n","\n","    latency_ms = round(\n","        (time.perf_counter() - start) * 1000,\n","        1,\n","    )\n","\n","    TOOL_AUDIT_LOG.append({\n","        \"response_id\": response_id,\n","        \"call_id\": call_id,\n","        \"tool\": name,\n","        \"arguments\": json.dumps(\n","            arguments,\n","            ensure_ascii=False,\n","        ),\n","        \"effect\": TOOL_EFFECTS.get(name, \"UNKNOWN\"),\n","        \"result\": json.dumps(\n","            result,\n","            ensure_ascii=False,\n","        ),\n","        \"latency_ms\": latency_ms,\n","    })\n","\n","    return json.dumps(result, ensure_ascii=False)\n"]},{"cell_type":"markdown","metadata":{},"source":["# 9. Wrapper de Bedrock: latencia, retries y uso\n","\n","Una API remota introduce fallos operativos reales:\n","\n","- timeout;\n","- conexión;\n","- rate limiting;\n","- errores HTTP.\n","\n","Aplicamos un retry pequeño para errores transitorios y registramos cada respuesta.\n","\n","Los datos son sintéticos, por lo que utilizamos `store=True` para poder continuar el flujo mediante `previous_response_id`.\n"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["MAX_RETRIES = 2\n","\n","def usage_to_dict(response):\n","    usage = getattr(response, \"usage\", None)\n","\n","    if usage is None:\n","        return {}\n","\n","    if hasattr(usage, \"model_dump\"):\n","        return usage.model_dump()\n","\n","    return {\n","        \"input_tokens\": getattr(\n","            usage,\n","            \"input_tokens\",\n","            None,\n","        ),\n","        \"output_tokens\": getattr(\n","            usage,\n","            \"output_tokens\",\n","            None,\n","        ),\n","        \"total_tokens\": getattr(\n","            usage,\n","            \"total_tokens\",\n","            None,\n","        ),\n","    }\n","\n","def create_bedrock_response(\n","    *,\n","    input_items,\n","    instructions,\n","    tools,\n","    previous_response_id=None,\n","    model_id=None,\n","):\n","    effective_model = model_id or MODEL_ID\n","    client = inference_client_for_model(effective_model)\n","\n","    last_error = None\n","\n","    for attempt in range(MAX_RETRIES + 1):\n","        start = time.perf_counter()\n","\n","        try:\n","            response = client.responses.create(\n","                model=effective_model,\n","                input=input_items,\n","                instructions=instructions,\n","                tools=tools,\n","                previous_response_id=previous_response_id,\n","                store=True,\n","                max_output_tokens=1200,\n","            )\n","\n","            latency_ms = round(\n","                (time.perf_counter() - start) * 1000,\n","                1,\n","            )\n","\n","            API_AUDIT_LOG.append({\n","                \"model\": effective_model,\n","                \"response_id\": response.id,\n","                \"previous_response_id\": previous_response_id,\n","                \"attempt\": attempt + 1,\n","                \"status\": \"OK\",\n","                \"latency_ms\": latency_ms,\n","                \"usage\": json.dumps(\n","                    usage_to_dict(response),\n","                    ensure_ascii=False,\n","                ),\n","            })\n","\n","            return response\n","\n","        except (\n","            APIConnectionError,\n","            APITimeoutError,\n","            RateLimitError,\n","        ) as exc:\n","            last_error = exc\n","\n","            API_AUDIT_LOG.append({\n","                \"model\": effective_model,\n","                \"response_id\": None,\n","                \"previous_response_id\": previous_response_id,\n","                \"attempt\": attempt + 1,\n","                \"status\": type(exc).__name__,\n","                \"latency_ms\": round(\n","                    (time.perf_counter() - start) * 1000,\n","                    1,\n","                ),\n","                \"usage\": \"{}\",\n","            })\n","\n","            if attempt >= MAX_RETRIES:\n","                raise\n","\n","            time.sleep(2 ** attempt)\n","\n","        except APIStatusError as exc:\n","            API_AUDIT_LOG.append({\n","                \"model\": effective_model,\n","                \"response_id\": None,\n","                \"previous_response_id\": previous_response_id,\n","                \"attempt\": attempt + 1,\n","                \"status\": f\"HTTP_{exc.status_code}\",\n","                \"latency_ms\": round(\n","                    (time.perf_counter() - start) * 1000,\n","                    1,\n","                ),\n","                \"usage\": \"{}\",\n","            })\n","            raise\n","\n","    raise last_error\n"]},{"cell_type":"markdown","metadata":{},"source":["# 10. Bucle agéntico visible\n","\n","Este es el núcleo de la práctica.\n","\n","Hasta ahora podríamos implementar el bucle correctamente y, aun así, ocultar casi todo el comportamiento interesante al alumno.\n","\n","A partir de esta versión mostramos explícitamente cada **ronda del agente**:\n","\n","```text\n","tarea\n","  ↓\n","respuesta Bedrock\n","  ↓\n","function_call elegido por el modelo\n","  ↓\n","ejecución de la tool\n","  ↓\n","observación devuelta al modelo\n","  ↓\n","nueva decisión\n","  ↓\n","...\n","  ↓\n","respuesta final\n","```\n","\n","Lo importante es observar que **no programamos una secuencia fija de tools**.\n","\n","El modelo decide:\n","\n","- si necesita una tool;\n","- cuál;\n","- con qué argumentos;\n","- si necesita